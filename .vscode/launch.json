{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AR3 LIFT：真机推理（回起点并执行）",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/scripts/ar3_lift_debug_python.sh",
            "program": "${workspaceFolder}/scripts/debug_ar3_lift_robot.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": {
                "INFER_ROS_DOMAIN_ID": "111",
                "INFER_AR3_WS": "${workspaceFolder}/../ar3_CartesianImpedanceControl",
                "OPENPI_PYTHON": "${workspaceFolder}/.venv/bin/python",
                "OPENPI_SERVE_GPU": "0"
            },
            "args": [
                "--checkpoint", "${workspaceFolder}/infer_checkpoint/25000",
                "--hardware", "auto",
                "--", "--execute", "--move-to-start",
                // 执行总块数：当前每块 10 个动作、10 Hz，35 块约 35 秒；改成 30 即约 30 秒。
                // 实际耗时另加模型等待时间；模型加载、预热和回起点不计入。此参数不改变每块动作长度。
                "--max-chunks", "55",
                "--home-file", "${workspaceFolder}/../ar3_CartesianImpedanceControl/config/cartesian_home.json",
                // "--task=Unplug the white charging plug from the white socket and place it on the table, don't bump your fingers into other objects"
                // "--task=plug the two-pronged white charger on the table into the white socket, don't bump your fingers into other objects, select the nearest hole position"
                "--task=Pick up a bottle and shake it, using force feedback to sense pills moving inside. If it contains  medicine, place it on top of the drawer; otherwise, put it back and try another"
            ]
        },
        {
            "name": "AR3 LIFT：检查（复用已启动硬件）",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/scripts/ar3_lift_debug_python.sh",
            "program": "${workspaceFolder}/scripts/debug_ar3_lift_robot.py",
