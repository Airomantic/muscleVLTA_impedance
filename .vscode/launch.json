            ]
        },
        {
            "name": "AR3 LIFT DAgger：推理+接管纠正采集（先运行 ./infer_oneclick.sh --dagger）",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/scripts/ar3_lift_debug_python.sh",
            "program": "${workspaceFolder}/scripts/debug_ar3_lift_robot.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false,
            "env": {
                "INFER_ROS_DOMAIN_ID": "111",
                "INFER_AR3_WS": "${workspaceFolder}/../ar3_CartesianImpedanceControl",
                "OPENPI_PYTHON": "${workspaceFolder}/.venv/bin/python",
